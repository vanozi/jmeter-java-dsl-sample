<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>us.abstracta.jmeter</groupId>
  <artifactId>jmeter-java-dsl-sample</artifactId>
  <version>0.1-SNAPSHOT</version>

  <properties>
    <!-- using Java 11 instead of 17 since is the latest LTS JMeter has support for -->
    <maven.compiler.release>11</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- your own spec: models are generated into package api.model once this file exists (see
      the own-api profile at the bottom). Use another file with
      -Dopenapi.spec=C:\path\to\spec.yaml -Pown-api -->
    <openapi.spec>${project.basedir}/openapi/api.yaml</openapi.spec>
    <!-- spec of the example in src/test/java/example -->
    <openapi.example.spec>${project.basedir}/openapi/example/test-api.yaml</openapi.example.spec>
  </properties>

  <build>
    <pluginManagement>
      <plugins>
        <!-- We force to use the latest version of surefire plugin to properly run junit5 tests -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.1.2</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.11.0</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!-- the generator fails on Windows paths with backslashes, so convert them to slashes -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>normalize-example-openapi-spec-path</id>
            <phase>initialize</phase>
            <goals>
              <goal>regex-property</goal>
            </goals>
            <configuration>
              <name>openapi.example.spec.normalized</name>
              <value>${openapi.example.spec}</value>
              <regex>\\</regex>
              <replacement>/</replacement>
              <failIfNoMatch>false</failIfNoMatch>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Generates request/response DTOs from OpenAPI specs into target/, as test sources -->
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <version>7.13.0</version>
        <!-- shared by all specs -->
        <configuration>
          <generatorName>java</generatorName>
          <library>native</library>
          <addCompileSourceRoot>false</addCompileSourceRoot>
          <addTestCompileSourceRoot>true</addTestCompileSourceRoot>
          <!-- generated models use common.invoker.ApiClient -->
          <invokerPackage>common.invoker</invokerPackage>

          <generateApis>false</generateApis>
          <generateApiTests>false</generateApiTests>
          <generateModelTests>false</generateModelTests>
          <generateModelDocumentation>false</generateModelDocumentation>
          <generateSupportingFiles>false</generateSupportingFiles>

          <configOptions>
            <useJakartaEe>true</useJakartaEe>
            <dateLibrary>java8</dateLibrary>
            <openApiNullable>false</openApiNullable>
            <serializationLibrary>jackson</serializationLibrary>
          </configOptions>
        </configuration>
        <executions>
          <execution>
            <id>example-api-models</id>
            <phase>generate-test-sources</phase>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>file:///${openapi.example.spec.normalized}</inputSpec>
              <output>${project.build.directory}/generated-test-sources/openapi-example</output>
              <modelPackage>example.api.model</modelPackage>
              <!-- the generator creates a duplicate OrderLineDto_1 for the array items in the
                OpenAPI 3.1 spec; map it back to the original -->
              <inlineSchemaNameMappings>
                <inlineSchemaNameMapping>OrderLineDto_1=OrderLineDto</inlineSchemaNameMapping>
              </inlineSchemaNameMappings>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <dependencies>
    <dependency>
      <groupId>us.abstracta.jmeter</groupId>
      <artifactId>jmeter-java-dsl</artifactId>
      <version>2.3</version>
      <scope>test</scope>
    </dependency>
    <!-- annotations used by the generated DTOs. Jackson itself comes with jmeter-java-dsl, so we
      don't pin another version that could conflict with JMeter -->
    <dependency>
      <groupId>jakarta.annotation</groupId>
      <artifactId>jakarta.annotation-api</artifactId>
      <version>2.1.1</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <version>5.10.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>3.24.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <profiles>
    <!-- generates models from your own spec into package api.model. Turns on by itself when
      openapi/api.yaml exists, so the project also builds before you add it -->
    <profile>
      <id>own-api</id>
      <activation>
        <file>
          <exists>${basedir}/openapi/api.yaml</exists>
        </file>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>normalize-openapi-spec-path</id>
                <phase>initialize</phase>
                <goals>
                  <goal>regex-property</goal>
                </goals>
                <configuration>
                  <name>openapi.spec.normalized</name>
                  <value>${openapi.spec}</value>
                  <regex>\\</regex>
                  <replacement>/</replacement>
                  <failIfNoMatch>false</failIfNoMatch>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.openapitools</groupId>
            <artifactId>openapi-generator-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>api-models</id>
                <phase>generate-test-sources</phase>
                <goals>
                  <goal>generate</goal>
                </goals>
                <configuration>
                  <inputSpec>file:///${openapi.spec.normalized}</inputSpec>
                  <output>${project.build.directory}/generated-test-sources/openapi</output>
                  <modelPackage>api.model</modelPackage>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>